{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vitest/globals", "vite/client"],
    "jsx": "preserve"
  },
  "include": ["convex/**/*.ts", "vitest.config.ts", "vitest.integration.config.ts", "eslint.config.ts"],
  "exclude": ["node_modules", "mcp_server"]
}
