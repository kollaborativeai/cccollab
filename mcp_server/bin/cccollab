#!/bin/sh
# POSIX shim that lives next to cccollab.mjs so a bare `cccollab` resolves
# when mcp_server/bin/ is on PATH (e.g. via test/start.sh). Windows uses
# cccollab.mjs directly through the npm-generated .cmd shim derived from
# package.json#bin, so this script is a no-op there.
DIR="$(cd "$(dirname "$0")" && pwd)"
exec node "$DIR/cccollab.mjs" "$@"
