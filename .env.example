# Convex dev deployment URL. Created via `npx convex dev`; do NOT commit the
# real value - keep the actual URL in `.env.local` (gitignored).
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment-name.convex.cloud
CONVEX_SITE_URL=https://your-deployment-name.convex.site

# The following variables are set in the Convex deployment itself (via
# `npx convex env set`), NOT in this file. Listed here only so humans know
# what the backend expects at runtime.
#
#   AUTH_GOOGLE_ID       - Google OAuth 2.0 client ID for cccollab
#   AUTH_GOOGLE_SECRET   - Google OAuth 2.0 client secret for cccollab
#   SITE_URL             - Post-auth redirect destination (Phase 4 sets this
#                          to the local MCP server's loopback callback)
