# Clerk — used by Convex to validate user JWTs.
# Copy your Clerk instance's JWT issuer domain here (e.g. https://your-app.clerk.accounts.dev).
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# Convex deployment URL (used by the optional plugin bridge to subscribe to messages).
# Leave empty to disable the Convex bridge; cccollab will run in local-broker-only mode.
CCCOLLAB_CONVEX_URL=

# Broker URL for the optional Convex->broker bridge.
CCCOLLAB_BROKER_URL=http://127.0.0.1:0

# DO NOT set this in production. When set to "1" in Convex, the /authorize
# endpoint accepts X-Test-User-Id headers as a Clerk-identity fallback. This
# is meant only for automated scenario tests where no real Clerk is present.
# Leave empty or unset in production. The HTTP endpoint will reject any
# X-Test-* headers unless this flag is on.
CCCOLLAB_ALLOW_TEST_AUTH=
