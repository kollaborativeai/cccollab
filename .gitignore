.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*
dist/
.env
*.env.*

# Per-project Claude Code local overrides
test/.claude/settings.local.json

# Stray codegraph init artifacts (top-level .codegraph is tracked intentionally)
/i/

.env.local

# Local git worktrees (never commit these — they're per-developer)
.worktrees/

# Python bytecode from the cctree tests
cctree/__pycache__/

# Wrangler's local cache, written by any `wrangler pages deploy` run against
# website/. Machine-specific and account-specific - never commit it, and keep it
# out of prettier's way.
.wrangler/
