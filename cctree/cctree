#!/usr/bin/env python3
"""
cctree — one interactive live map of every Claude Code session.

  cctree            live TUI: auto-refreshes, ↑↓/j k to move, Enter = jump to that
                    session's pane (tmux or iTerm2), q = quit
  cctree once       one-shot plain table (for piping / non-tty)
  cctree jump <tty> jump to the pane on <tty>

Columns: STATUS · WORKTREE · SESSION · CHANNELS · TOPICS · WHAT'S HAPPENING (one row each).
Data: c9watch (discovery+status) x git (worktree) x ~/projects (company)
      x cccollab broker/log (channels+topics, name-joined, best-effort).
"""
import subprocess, json, os, sys, time, collections, re, glob
from datetime import datetime

C9    = os.path.expanduser("~/.local/bin/c9watch")
PROJ  = os.path.expanduser("~/projects")
CCLOG = os.path.expanduser("~/.cccollab/logs/default.log")
BROKER = "http://localhost:50643"

FRIENDLY = {"pitcrew": "Pit Crew", "kollaborativeai": "Kollaborative AI",
            "tala": "tala", "tow123": "Tow123", "finance": "Finance",
            "automation": "Automation", "cccollab": "cccollab",
            "flatoutsolutions": "FlatOut Solutions", "travel": "Travel"}
# DERIVED status -> (label, ansi-color, group-priority). Groups: needs → working → idle.
# working / subagent / monitor are all GREEN — the session is actively doing something and is
# NOT blocked on you (executing a tool, running child agents, or watching for a background event).
STATUS = {"needs":    ("● NEEDS INPUT", "\033[1;31m", 0),
          "working":  ("▶ working",     "\033[1;32m", 1),
          "subagent": ("⚙ subagent",    "\033[1;32m", 1),
          "monitor":  ("◉ monitor",     "\033[1;32m", 1),
          "idle":     ("◦ idle",        "\033[33m",   2)}
RESET, DIM, CYAN, BOLD = "\033[0m", "\033[2m", "\033[1;36m", "\033[1m"

def parse_ts(iso):
    """ISO8601 (incl. nanosecond precision) -> epoch float; 0.0 on failure."""
    if not iso: return 0.0
    try:
        return datetime.fromisoformat(re.sub(r'(\.\d{6})\d+', r'\1', iso)).timestamp()
    except Exception:
        return 0.0

_txpath_cache = {}
def transcript_path(sid):
    """Path to a session's ~/.claude/projects/*/<id>.jsonl transcript (glob cached per id)."""
    if not sid: return ""
    if sid in _txpath_cache: return _txpath_cache[sid]
    m = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sid}.jsonl"))
    p = m[0] if m else ""
    _txpath_cache[sid] = p
    return p

_start_cache = {}
def session_start(sid):
    """Session start = birth time of its transcript (cached; birthtime never changes)."""
    if not sid: return 0.0
    if sid in _start_cache: return _start_cache[sid]
    t = 0.0
    p = transcript_path(sid)
    if p:
        try:
            st = os.stat(p); t = getattr(st, "st_birthtime", st.st_mtime)
        except OSError:
            t = 0.0
    _start_cache[sid] = t
    return t

def _user_text(e):
    cont = (e.get("message", {}) or {}).get("content")
    if isinstance(cont, str): return cont
    if isinstance(cont, list):
        return " ".join(c.get("text", "") for c in cont if isinstance(c, dict) and c.get("type") == "text")
    return ""

WORKING_MAX_AGE = 180   # a "still generating" session must have appended within this many seconds
LIVE_BG_MAX     = 7200  # a launched-but-not-ended background task counts as live for at most this
                        # long — self-heals a task orphaned by a killed session that never wrote an
                        # end-event (2h clears a stuck task without cutting off legit deploys/builds).
BG_TASK_MAX_AGE = 90    # fallback only: a bg task whose launch scrolled out of the transcript tail
                        # is live iff its .output was written within this many seconds.
TAIL_BYTES      = 400000  # transcript tail we parse. The watcher case (Monitor says "keep working"
                          # after arming) keeps generating output, so its launch can be far back —
                          # a generous tail keeps the launch in view. Re-parsed only on mtime change.

_WATCHER_RE = re.compile(r"\b(?:until|while)\b")
def _is_watcher_cmd(cmd):
    """A backgrounded poll/wait loop (watch a deploy/PR to completion, sleep, repeat) — a 'monitor'
    in spirit, not sub-work. e.g. `until [ "$(gh run view … .status)" = completed ]; do sleep 20; done`."""
    return bool(cmd) and bool(_WATCHER_RE.search(cmd)) and "sleep" in cmd

def _ended_task_ids(line):
    """Task-ids a genuine end-event reports as finished. Requires the structured <task-notification>
    wrapper (or a legacy stream-end form) so we never match assistant prose that merely quotes a
    <task-id>. Monitor ends land in queue-operation/attachment entries, bg-bash ends in user entries —
    matching on the wrapper rather than the entry type catches both."""
    if ("<task-notification>" not in line and "stream ended" not in line
            and "<status>completed</status>" not in line and "<status>failed</status>" not in line):
        return ()
    return re.findall(r"<task-id>([\w-]+)</task-id>", line)

_facts_cache = {}   # sid -> (transcript_mtime, armed_monitor, owes_output, bg_kind)
def _transcript_facts(sid, path, mt):
    """(armed_monitor, owes_output, bg_kind) from the transcript tail; mtime-cached (content-derived).
    bg_kind ∈ '' | 'monitor' | 'subagent' — the strongest LIVE background task (launched, no end-event,
    launch recent): a backgrounded watch/poll loop counts as 'monitor', real sub-work OR a running
    Workflow / background Agent as 'subagent'. Those run in-process and write nothing to this transcript
    while they run, so liveness comes from the pendingWorkflowCount / pendingBackgroundAgentCount that
    each turn's system stat carries (the parent still looks idle otherwise: last entry is assistant
    text, so owes=False)."""
    c = _facts_cache.get(sid)
    if c and c[0] == mt:
        return c[1], c[2], c[3]
    armed = owes = False
    bg_kind = ""
    pending_bg = 0      # Workflow-tool + background-Agent tasks in-process (latest turn's summed counts)
    try:
        with open(path, "rb") as f:
            f.seek(0, 2); size = f.tell(); f.seek(max(0, size - TAIL_BYTES))
            lines = f.read().decode("utf-8", "ignore").splitlines()
        mon_started, ended = set(), set()
        tool_cmd = {}       # bash tool_use_id -> command string (assistant precedes its launch result)
        bg_launch = {}      # background task-id -> (launch_epoch, command|None)
        for line in lines:
            m = re.search(r"Monitor started \(task (\w+)", line)
            if m: mon_started.add(m.group(1))
            ended.update(_ended_task_ids(line))
            if '"turn_duration"' in line:            # per-turn system stat → current background-work counts
                try:
                    e = json.loads(line)
                    wf = e.get("pendingWorkflowCount"); ba = e.get("pendingBackgroundAgentCount")
                    pending_bg = (wf if isinstance(wf, int) else 0) + (ba if isinstance(ba, int) else 0)
                except Exception:                    # absent → 0, so a completed turn clears it
                    pass
            if '"tool_use"' in line and '"Bash"' in line:      # remember each Bash command by id
                try:
                    e = json.loads(line)
                    for x in (e.get("message", {}) or {}).get("content", []) or []:
                        if isinstance(x, dict) and x.get("type") == "tool_use" and x.get("name") == "Bash":
                            tool_cmd[x.get("id")] = (x.get("input", {}) or {}).get("command", "")
                except Exception:
                    pass
            if "Command running in background with ID:" in line:   # a bg-bash launch → link to its cmd
                try:
                    e = json.loads(line)
                    ts = parse_ts(e.get("timestamp", ""))
                    tuid = next((x.get("tool_use_id")
                                 for x in (e.get("message", {}) or {}).get("content", []) or []
                                 if isinstance(x, dict) and x.get("type") == "tool_result"), None)
                    tid = (e.get("toolUseResult") or {}).get("backgroundTaskId")
                    if not tid:
                        mm = re.search(r"Command running in background with ID: (\w+)", line)
                        tid = mm.group(1) if mm else None
                    if tid:
                        bg_launch[tid] = (ts, tool_cmd.get(tuid))
                except Exception:
                    pass
        armed = bool(mon_started - ended)
        # classify live background bash tasks (launched, not ended, launch recent enough)
        now = time.time()
        live_watcher = live_work = False
        for tid, (ts, cmd) in bg_launch.items():
            if tid in ended: continue
            if ts and (now - ts) > LIVE_BG_MAX: continue       # ts==0 (unparseable) → don't cut off
            if _is_watcher_cmd(cmd or ""): live_watcher = True
            else: live_work = True
        if live_work or (pending_bg > 0 and (now - mt) < LIVE_BG_MAX):
            bg_kind = "subagent"               # a running Workflow / background Agent beats a mere watch
        elif live_watcher:
            bg_kind = "monitor"
        # fallback: a live .output whose launch scrolled out of the tail (can't classify → subagent).
        # Excludes ended task-ids, so a just-finished task's still-fresh .output no longer reads live.
        if not bg_kind:
            for fp in glob.glob(f"/private/tmp/claude-501/*/{sid}/tasks/*.output"):
                tid = os.path.basename(fp)[:-len(".output")]
                if tid in ended or tid in bg_launch: continue
                try:
                    if now - os.stat(fp).st_mtime < BG_TASK_MAX_AGE:
                        bg_kind = "subagent"; break
                except OSError:
                    pass
        for line in reversed(lines):                        # last substantive message
            try: e = json.loads(line)
            except Exception: continue
            t = e.get("type")
            if t == "assistant":
                content = (e.get("message", {}) or {}).get("content", []) or []
                has_text = any(isinstance(x, dict) and x.get("type") == "text"
                               and (x.get("text") or "").strip() for x in content)
                has_use = any(isinstance(x, dict) and x.get("type") == "tool_use" for x in content)
                owes = has_use and not has_text
                break
            if t == "user":
                txt = _user_text(e)
                if ("<local-command" in txt or "<command-name>" in txt
                        or "<command-message>" in txt):
                    continue                                # /model etc — not a real turn
                owes = "Request interrupted" not in txt
                break
    except Exception:
        armed = owes = False; bg_kind = ""
    _facts_cache[sid] = (mt, armed, owes, bg_kind)
    return armed, owes, bg_kind

def refine_idle(sid):
    """Refine an idle-classified session. Liveness comes from the transcript lifecycle (a task is
    launched until its end-event lands), NOT from .output mtime — so a sleeping watch-loop (0-byte,
    frozen mtime) still reads live, and a just-ended task stops reading live:
      'monitor'  — a live Monitor tool is armed, OR a backgrounded watch/poll loop is running.
      'subagent' — a live background work task (real sub-work, or an out-of-tail .output being written).
      'working'  — transcript appended within WORKING_MAX_AGE AND the assistant still owes output.
      'idle'     — anything stale. Idle for minutes/hours/days reads idle regardless of what the last
                   transcript entry happens to be (e.g. an unacted cccollab message)."""
    p = transcript_path(sid)
    if not p: return "idle"
    try:
        mt = os.stat(p).st_mtime
    except OSError:
        return "idle"
    armed, owes, bg_kind = _transcript_facts(sid, p, mt)
    if armed:
        return "monitor"
    if bg_kind:
        return bg_kind
    if owes and (time.time() - mt) < WORKING_MAX_AGE:
        return "working"
    return "idle"

def derive_status(s):
    """Turn c9watch's raw status into: needs (human action now) / subagent (working via a
    Task/fan-out child) / working (actively executing a tool) / idle (waiting for you).
    Only LIVE signals count as busy — a session mid-tool-call shows latestMessage 'Executing …'.
    Leftover todos (taskProgress total>completed) are NOT activity: a finished session can sit
    idle with todos still on its list, so taskProgress is deliberately ignored here."""
    raw  = s.get("status") or ""
    pend = s.get("pendingToolName") or ""
    lm   = s.get("latestMessage") or ""
    executing = lm.startswith("Executing ")
    # 1) explicit human-input tools always mean "needs you"
    if pend in ("Question", "AskUserQuestion"):
        return "needs"
    # 2) actively executing a tool RIGHT NOW → working, even if c9watch says NeedsAttention
    #    (a session mid-tool-call is not blocked on you; "Executing …" is the ground truth)
    if executing:
        return "subagent" if pend in ("Task", "Agent") else "working"
    # 2b) launched a background workflow/agents that run OUT of this process — parent looks idle
    #     (0% CPU, no pending tool) but is really working via background agents until it notifies.
    if lm.startswith("Workflow launched") or lm.startswith("Async agent launched"):
        return "subagent"
    # 3) not executing but flagged → genuinely waiting for the human (permission / idle prompt)
    if raw == "NeedsAttention":
        return "needs"
    if raw == "Working":
        return "working"
    return "idle"

def run(cmd, inp=None):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=15, input=inp).stdout
    except Exception:
        return ""

_git_cache = {}
def git_info(cwd):
    """(repo_name, is_linked_worktree, toplevel, repo_root).
    repo_name = origin-remote repo name (fallback: repo dir basename);
    is_linked_worktree = True only for `git worktree` checkouts (git-dir != common-dir);
    toplevel  = this checkout's working-tree root (git --show-toplevel);
    repo_root = the repo's main directory (main working tree, where .git lives)."""
    if not cwd: return ("(no cwd)", False, "", "")
    if cwd in _git_cache: return _git_cache[cwd]
    common = run(["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"]).strip()
    if common:
        top = run(["git", "-C", cwd, "rev-parse", "--show-toplevel"]).strip()
        root = os.path.dirname(common) if os.path.basename(common) == ".git" else (top or cwd)
        # repo NAME from origin remote (the real repo), not the local clone folder
        url = run(["git", "-C", cwd, "remote", "get-url", "origin"]).strip().rstrip("/")
        if url.endswith(".git"): url = url[:-4]
        repo = re.split(r"[/:]", url)[-1] if url else os.path.basename(root)
        gd = run(["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-dir"]).strip()
        linked = bool(gd and os.path.realpath(gd) != os.path.realpath(common))
    else:
        repo, linked, top, root = os.path.basename(cwd), False, "", ""
    res = (repo, linked, top, root)
    _git_cache[cwd] = res
    return res

def repo_of(cwd):
    return git_info(cwd)[0]

def company_of(cwd):
    if not cwd: return "(no cwd)"
    rel = os.path.relpath(os.path.realpath(cwd), PROJ)
    parts = rel.split(os.sep)
    if parts[0] == ".." or rel == ".": return "other"
    seg = parts[1] if parts[0] == "fv" and len(parts) > 1 else parts[0]
    return FRIENDLY.get(seg, seg.replace("_", " ").title())

def trunc(s, n): return s if len(s) <= n else (s[:n-1] + "…" if n > 0 else "")

# Ephemeral Task-tool subagents (review/verify agents spawned inside a real session).
# c9watch lists them as top-level sessions and inflates counts; hide by default.
SUBAGENT_PREFIXES = ("Review this change for security vulnerabilities",)
SHOW_SUBAGENTS = bool(os.environ.get("CCTREE_SHOW_SUBAGENTS"))
def is_subagent(s):
    return (s.get("firstPrompt") or "").startswith(SUBAGENT_PREFIXES)

# Dead sessions with an orphaned MCP leftover.
# c9watch discovers a session from a live process sharing its cwd. When a Claude session exits,
# most of its MCP subprocesses die with it — but some (notably `convex mcp` and `mongodb-mcp-server`)
# linger, get reparented to launchd (ppid 1), and keep the dead session's cwd. c9watch then still
# reports the session, backed only by that orphan, so it never leaves the map. A LIVE session always
# has its own entry whose pid chains to a live `claude` (ppid != 1) — even when it reuses a worktree a
# dead session also used — so hiding orphan-backed rows drops only the ghosts, never a live session.
# (A `claude` reparented to launchd is a live session launched by launchd, not a leftover — hence the
# comm guard.) A fully-gone pid is NOT hidden here: c9watch self-heals it on its next scan, whereas a
# lingering MCP orphan persists indefinitely — that persistence is the bug this targets.
SHOW_DEAD = bool(os.environ.get("CCTREE_SHOW_DEAD"))
def is_dead_orphan(meta):
    """meta = (ppid, comm) for the session's c9watch pid, or None if the pid is gone. Dead iff the
    process is orphaned to launchd (ppid 1) AND is not itself a claude process."""
    if not meta: return False
    ppid, comm = meta
    return ppid == "1" and not comm.rstrip().endswith("claude")

def cccollab_membership():
    name2ch, live = {}, set()
    try:
        data = json.loads(run(["curl", "-s", "-m", "2", f"{BROKER}/sessions"]))
        for s in data.get("sessions", []):
            chs = [c if isinstance(c, str) else c.get("name") for c in s.get("channels", [])]
            name2ch[s["name"]] = [c for c in chs if c]; live.add(s["name"])
    except Exception:
        pass
    topicname, topics_by = {}, {}
    try:
        with open(CCLOG, errors="ignore") as f:
            for line in f:
                m = re.search(r'TOPIC CREATED \S+: (\S+) "([^"]+)"', line)
                if m: topicname[m.group(1)] = m.group(2); continue
                m = re.search(r'SESSION REGISTERED: (.+?)(?: \(|$)', line)
                if m: topics_by[m.group(1).strip()] = set(); continue
                m = re.search(r'JOIN: (.+?) joined topic (\S+)', line)
                if m: topics_by.setdefault(m.group(1).strip(), set()).add(m.group(2)); continue
                m = re.search(r'LEAVE: (.+?) left topic (\S+)', line)
                if m: topics_by.get(m.group(1).strip(), set()).discard(m.group(2)); continue
    except Exception:
        pass
    return {name: {"channels": sorted(name2ch.get(name, [])),
                   "topics": sorted(topicname.get(t, t[:8]) for t in topics_by.get(name, ()))}
            for name in live}

def match_cccollab(row_name, members):
    if not row_name or not members: return None
    rn = row_name.lower().strip()
    for name in members:
        if name.lower() == rn: return members[name]
    if len(rn) < 5: return None
    for name in members:
        nl = name.lower()
        if len(nl) >= 5 and (nl in rn or rn in nl): return members[name]
    return None

def gather():
    """List of session dicts (untruncated fields); ordered grouped by company."""
    try:
        sessions = json.loads(run([C9, "list"]))["sessions"]
    except Exception:
        return None
    pid2tty, pid_meta = {}, {}
    pids = [str(s["pid"]) for s in sessions if s.get("pid")]
    if pids:
        # comm can contain spaces (node procs set argv0 to a title), so it must come last; split(3).
        for line in run(["ps", "-o", "pid=,ppid=,tty=,comm="] + sum([["-p", p] for p in pids], [])).splitlines():
            p = line.split(None, 3)
            if len(p) >= 4:
                pid, ppid, tty, comm = p[0], p[1], p[2], p[3]
                pid2tty[pid] = tty if tty.startswith("/dev/") else "/dev/" + tty
                pid_meta[pid] = (ppid, comm)
    members = cccollab_membership()
    rows = []
    for s in sessions:
        if not SHOW_SUBAGENTS and is_subagent(s):
            continue
        if not SHOW_DEAD and is_dead_orphan(pid_meta.get(str(s.get("pid")))):
            continue
        cwd = s.get("projectPath", "")
        full = s.get("customTitle") or s.get("sessionName") or "?"
        cc = match_cccollab(full, members)
        real = os.path.realpath(cwd) if cwd else ""
        repo, linked, top, root = git_info(cwd)
        rtop = os.path.realpath(top) if top else ""
        rroot = os.path.realpath(root) if root else ""
        # Merged WORKTREE/FOLDER column:
        #   linked worktree            → the worktree name (basename of its root)
        #   non-worktree in a subfolder → the path within the repo (e.g. clients/amanda_george)
        #   non-worktree at repo root   → empty
        if linked:
            loc = os.path.basename(rtop) if rtop else os.path.basename(real)
        elif rtop and real and real != rtop:
            loc = os.path.relpath(real, rtop)
        else:
            loc = ""
        st = derive_status(s)
        if st == "idle":                                  # refine via transcript: monitor / generating / idle
            st = refine_idle(s.get("id", ""))
        rows.append({
            "id":       s.get("id", "") or str(s.get("pid", "")),
            "company":  company_of(cwd),
            "status":   st,
            "repo":     repo,
            "worktree": loc,
            "name":     full,
            "msg":      (s.get("latestMessage") or "").replace("\n", " ").strip(),
            "channels": ",".join(cc["channels"]) if cc else "",
            "topics":   ",".join(cc["topics"]) if cc else "",
            "pid":      s.get("pid"),
            "tty":      pid2tty.get(str(s.get("pid")), ""),
            "mtime":    parse_ts(s.get("modified", "")),
            "start":    session_start(s.get("id", "")),
        })
    return rows

def col_widths(maxx):
    """Distribute width across STATUS·REPO·WORKTREE/FOLDER·SESSION·CHANNELS·TOPICS·MESSAGE."""
    SW = 13
    rem = maxx - 2 - (SW + 2)
    RE = min(16, max(8, int(rem * 0.10)))
    WT = min(26, max(12, int(rem * 0.15)))
    NW = min(38, max(16, int(rem * 0.22)))
    CW = min(26, max(10, int(rem * 0.13)))
    TW = min(28, max(10, int(rem * 0.14)))
    MW = max(10, rem - (RE + 2 + WT + 2 + NW + 2 + CW + 2 + TW + 2))
    return SW, RE, WT, NW, CW, TW, MW

def _sort_key(r):
    """Within a company: needs → working → idle, then by time:
    needs   → longest-waiting first (oldest last-activity at top)
    working → longest-working first (earliest session start at top)
    idle    → shortest-idle first  (newest last-activity at top, stalest at bottom)."""
    st = r["status"]; prio = STATUS.get(st, ("", "", 9))[2]
    if st == "idle":
        return (prio, -r.get("mtime", 0.0))
    if st in ("working", "subagent", "monitor"):
        return (prio, r.get("start") or r.get("mtime", 0.0))
    return (prio, r.get("mtime", 0.0))            # needs: oldest first

def grouped(rows, collapsed=frozenset()):
    """-> list of ('header', company, n) / ('row', dict). Collapsed companies show header only."""
    g = collections.defaultdict(list)
    for r in rows: g[r["company"]].append(r)
    out = []
    for comp, items in sorted(g.items(), key=lambda x: -len(x[1])):
        out.append(("header", comp, len(items)))
        if comp not in collapsed:
            for r in sorted(items, key=_sort_key):
                out.append(("row", r))
    return out

# ---------- one-shot (plain ANSI) ----------
def render_once():
    rows = gather()
    if rows is None:
        return f"\033[1;31mcctree:\033[0m cannot read c9watch (~/.local/bin/c9watch)"
    try: maxx = os.get_terminal_size().columns
    except Exception: maxx = 200
    SW, RE, WT, NW, CW, TW, MW = col_widths(maxx)
    needs = sum(1 for r in rows if r["status"] == "needs")
    work  = sum(1 for r in rows if r["status"] in ("working", "subagent", "monitor"))
    idle  = sum(1 for r in rows if r["status"] == "idle")
    L = [f"\n{BOLD}Claude Code — live map{RESET}   {len(rows)} sessions · "
         f"\033[1;31m{needs} need input{RESET} · \033[33m{idle} idle{RESET} · \033[1;32m{work} working{RESET}   {DIM}{time.strftime('%H:%M:%S')}{RESET}",
         f"  {DIM}{'STATUS'.ljust(SW)}  {'REPO'.ljust(RE)}  {'WORKTREE/FOLDER'.ljust(WT)}  "
         f"{'SESSION'.ljust(NW)}  {'CHANNELS'.ljust(CW)}  {'TOPICS'.ljust(TW)}  WHAT'S HAPPENING{RESET}"]
    for kind, *rest in grouped(rows):
        if kind == "header":
            comp, n = rest; L.append(f"{CYAN}{comp}{RESET} {DIM}({n}){RESET}")
        else:
            r = rest[0]; label, color, _ = STATUS.get(r["status"], (r["status"], "", 9))
            L.append(f"  {color}{label.ljust(SW)}{RESET}  {trunc(r['repo'],RE).ljust(RE)}  "
                     f"{trunc(r['worktree'],WT).ljust(WT)}  {BOLD}{trunc(r['name'],NW).ljust(NW)}{RESET}  "
                     f"{CYAN}{trunc(r['channels'],CW).ljust(CW)}{RESET}  {DIM}{trunc(r['topics'],TW).ljust(TW)}{RESET}  {DIM}{trunc(r['msg'],MW)}{RESET}")
    return "\n".join(L)

# ---------- jump ----------
def _iterm_focus_by(cond):
    # Focus the matching pane AND switch to its macOS Space. select s/t/w reveals the pane;
    # `set index of w to 1` makes it the frontmost iTerm window; AXRaise via System Events is
    # what actually pulls macOS to that window's Space (a plain `activate` alone won't unless
    # "switch to a Space with open windows" is enabled in Mission Control settings).
    script = ('tell application "iTerm2"\n  activate\n'
              '  repeat with w in windows\n    repeat with t in tabs of w\n'
              '      repeat with s in sessions of t\n'
              f'        if {cond} then\n          select s\n          select t\n          select w\n'
              '          set index of w to 1\n          set winName to name of w\n'
              '          tell application "System Events" to tell process "iTerm2"\n'
              '            set frontmost to true\n'
              '            try\n              perform action "AXRaise" of (first window whose title is winName)\n            end try\n'
              '          end tell\n          return "ok"\n        end if\n'
              '      end repeat\n    end repeat\n  end repeat\nend tell\nreturn "notfound"\n')
    return "ok" in run(["osascript", "-e", script])

def jump(name="", tty=""):
    """Focus a session's pane. PRIMARY: match iTerm pane TITLE to the session name (ground truth,
    robust to c9watch's pid mis-attribution for same-cwd sessions). FALLBACK: tty (tmux or iTerm)."""
    if name and name not in ("?", "") and len(name) >= 4:
        esc = name.replace("\\", "\\\\").replace('"', '\\"')
        if _iterm_focus_by(f'(name of s) contains "{esc}"'):
            return f"iterm:{name}"
    if tty:
        tty = tty if tty.startswith("/dev/") else "/dev/" + tty
        tm = run(["tmux", "list-panes", "-a", "-F", "#{pane_tty}\t#{session_name}:#{window_index}.#{pane_index}"])
        tmap = dict(l.split("\t", 1) for l in tm.splitlines() if "\t" in l)
        if tty in tmap:
            target = tmap[tty]; win = target.rsplit(".", 1)[0]; sess = target.split(":", 1)[0]
            run(["tmux", "select-pane", "-t", target]); run(["tmux", "select-window", "-t", win])
            run(["tmux", "switch-client", "-t", sess])
            run(["osascript", "-e", 'tell application "iTerm2" to activate'])
            return f"tmux:{target}"
        if _iterm_focus_by(f'(tty of s) is "{tty}"'):
            return f"iterm-tty:{tty}"
    return "notfound"

def chrome_jump(name):
    """Switch to the first Chrome tab whose title CONTAINS the full session name, and switch
    to its Space. Graceful no-op if Chrome isn't running or no tab matches (never launches
    Chrome, never navigates/creates tabs — activate-existing-tab only)."""
    if not name or len(name) < 3 or name == "?":
        return "no match"
    esc = name.replace("\\", "\\\\").replace('"', '\\"')
    script = (
        'tell application "System Events"\n'
        '  if not (exists process "Google Chrome") then return "no-chrome"\n'
        'end tell\n'
        'tell application "Google Chrome"\n'
        '  repeat with w in windows\n    set i to 0\n'
        '    repeat with t in tabs of w\n      set i to i + 1\n'
        f'      if (title of t) contains "{esc}" then\n'
        '        set active tab index of w to i\n        set index of w to 1\n        activate\n'
        '        return "ok"\n      end if\n'
        '    end repeat\n  end repeat\nend tell\nreturn "notfound"\n')
    out = run(["osascript", "-e", script]).strip()
    if out == "ok":
        # pull macOS to the tab's Space (best-effort; needs Accessibility permission)
        raise_ = ('tell application "System Events" to tell process "Google Chrome"\n'
                  '  set frontmost to true\n'
                  f'  try\n    perform action "AXRaise" of (first window whose title contains "{esc}")\n  end try\n'
                  'end tell\n')
        run(["osascript", "-e", raise_])
        return "chrome:ok"
    return {"no-chrome": "chrome-not-running", "notfound": "no-tab"}.get(out, "no-tab")

def _pane_tty_by_name(name):
    esc = name.replace("\\", "\\\\").replace('"', '\\"')
    script = ('tell application "iTerm2"\n  repeat with w in windows\n    repeat with t in tabs of w\n'
              '      repeat with s in sessions of t\n'
              f'        if (name of s) contains "{esc}" then return (tty of s)\n'
              '      end repeat\n    end repeat\n  end repeat\nend tell\nreturn ""\n')
    return run(["osascript", "-e", script]).strip()

def _claude_pids_on_tty(ptty):
    short = ptty.replace("/dev/", "")
    out, pids = run(["ps", "-t", short, "-o", "pid=,comm="]), []
    for l in out.splitlines():
        parts = l.split(None, 1)
        if len(parts) == 2 and parts[1].strip().endswith("claude"):
            pids.append(parts[0])
    return pids

def kill_session(name="", tty="", pid=None):
    """Kill a session. Order:
    1) LIVE session — its iTerm pane (title 'NAME (node)') has a claude process → kill that claude.
       Pane match requires the ' (node)' suffix so 'tala' can't hit 'tala Assessment'.
    2) STALE/no-pane/orphaned — fall back to the c9watch-reported pid + its descendants
       (clears lingering MCP leftovers of an exited session). This is what makes stale kills work."""
    # 1) live pane by exact-ish name
    if name and len(name) >= 3:
        ptty = _pane_tty_by_name(f"{name} (node)") or _pane_tty_by_name(f"{name} (")
        if ptty.startswith("/dev/"):
            cp = _claude_pids_on_tty(ptty)
            if cp:
                for p in cp:
                    try: subprocess.run(["kill", p], timeout=5)
                    except Exception: pass
                return f"killed claude {','.join(cp)} (pane)"
    # 1b) a tty we already know, with a live claude
    if tty.startswith("/dev/"):
        cp = _claude_pids_on_tty(tty)
        if cp:
            for p in cp:
                try: subprocess.run(["kill", p], timeout=5)
                except Exception: pass
            return f"killed claude {','.join(cp)} (tty)"
    # 2) fallback: c9watch pid + its descendants (stale/orphaned/duplicate — per-row unique)
    if pid:
        pid = str(pid)
        if not run(["ps", "-o", "pid=", "-p", pid]).strip():
            return f"pid {pid} already gone"
        kids = run(["pgrep", "-P", pid]).split()
        for p in [pid] + kids:
            try: subprocess.run(["kill", p], timeout=5)
            except Exception: pass
        return f"killed pid {pid} (+{len(kids)} children)"
    return "could not resolve process (not killed)"

# ---------- interactive TUI ----------
def run_tui(stdscr):
    import curses, threading
    curses.curs_set(0)
    curses.use_default_colors()
    for i, fg in enumerate([curses.COLOR_RED, curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_CYAN], 1):
        curses.init_pair(i, fg, -1)
    RED = curses.color_pair(1) | curses.A_BOLD
    GRN = curses.color_pair(2) | curses.A_BOLD
    YEL = curses.color_pair(3)
    CYN = curses.color_pair(4)
    st_attr = {"needs": ("● NEEDS INPUT", RED), "idle": ("◦ idle", YEL),
               "subagent": ("⚙ subagent", GRN), "working": ("▶ working", GRN),
               "monitor": ("◉ monitor", GRN)}

    # Refresh cadence. `c9watch list` is ~1s of CPU per call, so poll gently (default 4s).
    # Override with CCTREE_INTERVAL=<seconds>.
    try: interval = max(1.0, float(os.environ.get("CCTREE_INTERVAL", "4")))
    except Exception: interval = 4.0
    shared = {"rows": gather() or []}
    lock, stop = threading.Lock(), threading.Event()
    def refresher():
        while not stop.is_set():
            g = gather() or []
            with lock: shared["rows"] = g
            stop.wait(interval)
    threading.Thread(target=refresher, daemon=True).start()

    stdscr.timeout(100)
    collapsed = set()
    sel, sel_key, top = 0, None, 0
    pending_kill, flash = None, ("", 0.0)

    def keyof(d):  return ("h", d[1]) if d[0] == "header" else ("s", d[1].get("id"))
    def comp_of(d): return d[1] if d[0] == "header" else d[1]["company"]

    def put(y, x, text, attr, maxx):
        if not (0 <= y < curses.LINES) or x >= maxx: return x
        text = text[:max(0, maxx - x)]
        try: stdscr.addstr(y, x, text, attr)
        except curses.error: pass
        return x + len(text)

    def read_key():
        c = stdscr.getch()
        if c != 27:
            return ("k", c)
        seq = ""
        stdscr.timeout(30)            # brief window to catch the rest of an ESC sequence (no race)
        for _ in range(6):
            ch = stdscr.getch()
            if ch == -1: break
            seq += chr(ch)
        stdscr.timeout(100)
        return ("esc", seq) if seq else ("k", 27)

    try:
        while True:
            with lock: rows = shared["rows"]
            disp = grouped(rows, collapsed)
            if sel_key is not None:
                found = next((i for i, d in enumerate(disp) if keyof(d) == sel_key), None)
                if found is not None: sel = found
            sel = max(0, min(sel, len(disp) - 1)) if disp else 0
            if disp: sel_key = keyof(disp[sel])

            maxy, maxx = stdscr.getmaxyx()
            SW, RE, WT, NW, CW, TW, MW = col_widths(maxx)
            H = maxy - 2
            if sel < top: top = sel
            elif sel >= top + H: top = sel - H + 1
            top = max(0, min(top, max(0, len(disp) - H)))

            stdscr.erase()
            needs = sum(1 for r in rows if r["status"] == "needs")
            work  = sum(1 for r in rows if r["status"] in ("working", "subagent", "monitor"))
            idle  = sum(1 for r in rows if r["status"] == "idle")
            if pending_kill is not None:
                put(0, 0, f"⚠ Kill '{str(pending_kill.get('name'))[:44]}' ?   y = confirm · any other key = cancel", RED, maxx)
            elif flash[1] > time.time():
                put(0, 0, flash[0], GRN, maxx)
            else:
                x = put(0, 0, f"Claude Code — {len(rows)} sessions   ", curses.A_BOLD, maxx)
                x = put(0, x, f"{needs} need input", RED, maxx)
                x = put(0, x + 2, f"{idle} idle", YEL, maxx)
                put(0, x + 2, f"{work} working", GRN, maxx)
                put(0, max(0, maxx - 62), "↑↓ move · Tab/⇧Tab project · ←/→ fold · ⏎ chrome+pane · c chrome · x kill · q", curses.A_DIM, maxx)
            put(1, 2, f"{'STATUS'.ljust(SW)}  {'REPO'.ljust(RE)}  {'WORKTREE/FOLDER'.ljust(WT)}  "
                      f"{'SESSION'.ljust(NW)}  {'CHANNELS'.ljust(CW)}  {'TOPICS'.ljust(TW)}  WHAT'S HAPPENING", curses.A_DIM, maxx)
            y = 2
            for di in range(top, len(disp)):
                if y >= maxy: break
                d = disp[di]; rev = curses.A_REVERSE if di == sel else 0
                if d[0] == "header":
                    marker = "▸ " if d[1] in collapsed else "▾ "
                    xx = put(y, 0, marker + d[1], CYN | curses.A_BOLD | rev, maxx)
                    put(y, xx + 1, f"({d[2]})", curses.A_DIM | rev, maxx)
                else:
                    r = d[1]
                    label, at = st_attr.get(r["status"], (r["status"], 0))
                    xx = 2
                    xx = put(y, xx, label.ljust(SW), at | rev, maxx); xx += 2
                    xx = put(y, xx, trunc(r["repo"], RE).ljust(RE), rev, maxx); xx += 2
                    xx = put(y, xx, trunc(r["worktree"], WT).ljust(WT), rev, maxx); xx += 2
                    xx = put(y, xx, trunc(r["name"], NW).ljust(NW), curses.A_BOLD | rev, maxx); xx += 2
                    xx = put(y, xx, trunc(r["channels"], CW).ljust(CW), CYN | rev, maxx); xx += 2
                    xx = put(y, xx, trunc(r["topics"], TW).ljust(TW), curses.A_DIM | rev, maxx); xx += 2
                    put(y, xx, trunc(r["msg"], MW), curses.A_DIM | rev, maxx)
                y += 1
            stdscr.refresh()

            if not disp:
                if read_key() == ("k", ord('q')): break
                continue
            typ, val = read_key()
            if typ == "k" and val == -1:
                continue
            if pending_kill is not None:
                if typ == "k" and val in (ord('y'), ord('Y')):
                    res = kill_session(pending_kill.get("name"), pending_kill.get("tty"), pending_kill.get("pid"))
                    flash = (f"killed {str(pending_kill.get('name'))[:26]} → {res}", time.time() + 3)
                pending_kill = None
                continue
            headers = [i for i, d in enumerate(disp) if d[0] == "header"]
            stay_comp = None   # when set, pin the cursor to this project's header after rebuild
            if typ == "k":
                c = val
                if c in (curses.KEY_DOWN, ord('j')): sel += 1
                elif c in (curses.KEY_UP, ord('k')): sel -= 1
                elif c == 9:                       # Tab → next project (reliable, no modifier)
                    nxt = [h for h in headers if h > sel]
                    if nxt: sel = nxt[0]
                elif c == curses.KEY_BTAB:         # Shift+Tab → previous project
                    prev = [h for h in headers if h < sel]
                    if prev: sel = prev[-1]
                elif c == curses.KEY_NPAGE: sel += 10
                elif c == curses.KEY_PPAGE: sel -= 10
                elif c == curses.KEY_LEFT:
                    stay_comp = comp_of(disp[sel]); collapsed.add(stay_comp)
                elif c == curses.KEY_RIGHT:
                    stay_comp = comp_of(disp[sel]); collapsed.discard(stay_comp)
                elif c in (curses.KEY_ENTER, 10, 13):
                    d = disp[sel]
                    if d[0] == "row":
                        curses.flushinp()
                        chrome_jump(d[1].get("name"))                 # Chrome tab first (best-effort)
                        jump(d[1].get("name"), d[1].get("tty"))       # then the CC session pane (ends frontmost)
                    else:
                        stay_comp = d[1]
                        (collapsed.discard if d[1] in collapsed else collapsed.add)(d[1])
                elif c in (ord('x'), ord('X')):
                    if disp[sel][0] == "row": pending_kill = disp[sel][1]
                elif c in (ord('c'), ord('C')):
                    if disp[sel][0] == "row":
                        res = chrome_jump(disp[sel][1].get("name"))
                        if res != "chrome:ok":       # only flash on non-open (no tab / no chrome)
                            flash = (f"Chrome: {res}", time.time() + 2)
                elif c == ord('q'): break
            else:  # escape sequence (Ctrl/Shift/⌘ arrows: ESC [1;5x or [1;2x)
                seq = val
                if seq in ("[1;5A", "[1;2A"):      # previous project
                    prev = [h for h in headers if h < sel]
                    if prev: sel = prev[-1]
                elif seq in ("[1;5B", "[1;2B"):    # next project
                    nxt = [h for h in headers if h > sel]
                    if nxt: sel = nxt[0]
                elif seq in ("[1;5D", "[1;2D"):    # collapse
                    stay_comp = comp_of(disp[sel]); collapsed.add(stay_comp)
                elif seq in ("[1;5C", "[1;2C"):    # expand
                    stay_comp = comp_of(disp[sel]); collapsed.discard(stay_comp)
            if disp:
                sel = max(0, min(sel, len(disp) - 1))
                sel_key = ("h", stay_comp) if stay_comp is not None else keyof(disp[sel])
    finally:
        stop.set()

def keys_debug(stdscr):
    import curses
    stdscr.timeout(-1)
    stdscr.addstr(0, 0, "cctree key debug — press keys (try ⌘↑, Ctrl+↑, Shift+↑). q to quit.")
    stdscr.refresh()
    y = 2
    while True:
        c = stdscr.getch()
        if c == 27:
            stdscr.nodelay(True); seq = ""
            for _ in range(8):
                ch = stdscr.getch()
                if ch == -1: break
                seq += chr(ch)
            stdscr.nodelay(False)
            line = f"ESC + {seq!r}   (an escape sequence — bindable)"
        elif c == ord('q'):
            break
        else:
            try: nm = curses.keyname(c).decode()
            except Exception: nm = "?"
            line = f"code {c}  keyname {nm}"
        row = 2 + (y - 2) % (curses.LINES - 3)
        try: stdscr.addstr(row, 0, line.ljust(curses.COLS - 1)); stdscr.refresh()
        except curses.error: pass
        y += 1

def main():
    a = sys.argv[1:]
    if a and a[0] == "keys":
        import curses; curses.wrapper(keys_debug); return
    if a and a[0] == "jump" and len(a) > 1:
        arg = a[1]
        print(jump(tty=arg) if arg.startswith(("/dev/", "ttys")) else jump(name=arg)); return
    if a and a[0] == "once":
        print(render_once()); return
    if not sys.stdout.isatty():
        print(render_once()); return
    try:
        import curses
        curses.wrapper(run_tui)
    except Exception as e:
        sys.stderr.write(f"cctree TUI error: {e}\n")
        print(render_once())

if __name__ == "__main__":
    main()
