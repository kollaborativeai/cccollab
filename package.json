{
  "name": "cccollab-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo root for the cccollab MCP server workspace.",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "mcp_server"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "yarn workspaces foreach -A --topological-dev --no-private run build",
    "test": "yarn workspaces foreach -A --no-private run test",
    "test:integration": "yarn workspace cccollab run test:integration",
    "lint": "yarn workspaces foreach -A --no-private run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "yarn workspaces foreach -A --no-private run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "hono": "^4.12.33",
    "tar": "^7.5.22",
    "fast-uri": "^3.1.5",
    "ws": "^8.21.1",
    "js-yaml": "^4.3.1",
    "postcss": "^8.5.25",
    "vite": "^8.2.0",
    "brace-expansion": "^5.0.9"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
