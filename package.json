{
  "name": "cccollab",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo root: the @flatoutsolutions/cccollab MCP server workspace and the shared Convex backend.",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "mcp_server"
  ],
  "type": "module",
  "scripts": {
    "dev": "npx convex dev",
    "build": "yarn workspaces foreach -A --topological-dev --no-private run build",
    "test": "vitest run && yarn workspaces foreach -A --no-private run test",
    "test:convex": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts && yarn workspace @flatoutsolutions/cccollab run test:integration",
    "lint": "eslint . && yarn workspaces foreach -A --no-private run lint",
    "lint:convex": "eslint convex",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && yarn workspaces foreach -A --no-private run typecheck",
    "prepare": "husky",
    "convex:stub": "node scripts/gen-convex-stub.mjs --force",
    "postinstall": "node scripts/gen-convex-stub.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.37.0",
    "@convex-dev/auth": "^0.0.91",
    "convex": "^1.35.1",
    "convex-helpers": "^0.1.114"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "convex-test": "^0.0.49",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  },
  "resolutions": {
    "hono": "^4.12.14"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
