{
  "name": "cccollab",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo root for the @flatoutsolutions/cccollab MCP server workspace.",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "mcp_server"
  ],
  "type": "module",
  "scripts": {
    "build": "yarn workspaces foreach -A --topological-dev --no-private run build",
    "test": "yarn workspaces foreach -A --no-private run test",
    "test:integration": "yarn workspace @flatoutsolutions/cccollab run test:integration",
    "lint": "yarn workspaces foreach -A --no-private run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "yarn workspaces foreach -A --no-private run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "hono": "^4.12.14"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
