{
  /* This TypeScript project config describes the environment that Convex
   * functions run in and is used to typecheck them. Convex's CLI reads this
   * file directly, so changes here affect both the IDE and `npx convex dev`.
   *
   * The settings below are the minimum required by Convex plus the Node
   * types so that reads of `process.env` (e.g. in `auth.config.ts`) type-
   * check. Convex injects a small set of process env vars at runtime; the
   * Node types let TypeScript see them.
   */
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
